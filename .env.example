# Скопіюйте у .env і заповніть. Файл .env НЕ комітиться в Git.

# --- Django ---
# Локально: True. На сервері: False.
DJANGO_DEBUG=True
# Обов'язково на сервері. Згенерувати:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Через кому, без пробілів. Напр.: example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Повні origin зі схемою. Напр.: https://example.com,https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- HTTPS / cookies (на сервері за замовчуванням увімкнено, коли DEBUG=False) ---
# DJANGO_SECURE_COOKIES=True
# DJANGO_SECURE_SSL_REDIRECT=True
# Увімкніть HSTS лише після перевірки, що HTTPS працює стабільно (напр. 31536000)
DJANGO_SECURE_HSTS_SECONDS=0
# True, якщо Django працює за nginx/іншим проксі, що передає X-Forwarded-Proto
DJANGO_BEHIND_PROXY=False

# --- Шляхи (необов'язково) ---
# DJANGO_SQLITE_PATH=/var/lib/mobihome/db.sqlite3
# DJANGO_MEDIA_ROOT=/var/lib/mobihome/media
# DJANGO_STATIC_ROOT=/var/www/mobihome/static

# --- Пошта (відновлення пароля). У DEBUG листи виводяться в консоль. ---
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=mobi home <noreply@example.com>

# --- Google OAuth 2.0 (порожньо = вхід через Google вимкнено) ---
# https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application
# Authorized redirect URI: https://<ваш-домен>/auth/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram Login Widget (порожньо = вхід через Telegram вимкнено) ---
# Створити бота в @BotFather, потім /setdomain -> ваш домен
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# --- Обмеження спроб входу ---
LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_WINDOW_SECONDS=900

# --- Платне розміщення ---
# True: у каталозі лише оголошення з оплаченим розміщенням (placement_until > now).
# Вмикати разом із запуском оплати LiqPay.
PLACEMENT_PAYMENT_REQUIRED=False
