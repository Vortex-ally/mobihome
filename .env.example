# Скопіюйте у .env і заповніть. Файл .env НЕ комітиться в Git.

# --- Django ---
# Локально: True. На сервері: False.
DJANGO_DEBUG=True
# Обов'язково на сервері. Згенерувати:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# Через кому, без пробілів. Напр.: example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Повні origin зі схемою. Напр.: https://example.com,https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- HTTPS / cookies (на сервері за замовчуванням увімкнено, коли DEBUG=False) ---
# DJANGO_SECURE_COOKIES=True
# DJANGO_SECURE_SSL_REDIRECT=True
# Увімкніть HSTS лише після перевірки, що HTTPS працює стабільно (напр. 31536000)
DJANGO_SECURE_HSTS_SECONDS=0
# True, якщо Django працює за nginx/іншим проксі, що передає X-Forwarded-Proto і X-Real-IP
DJANGO_BEHIND_PROXY=False
# Адреси proxy, від яких приймається X-Real-IP (порожній REMOTE_ADDR — unix-сокет Gunicorn — довірений завжди)
# DJANGO_TRUSTED_PROXY_IPS=127.0.0.1,::1

# --- Спільний кеш лімітів входу/форм (production: обов'язково при DJANGO_BEHIND_PROXY=True) ---
# Redis лише на localhost або unix-сокеті; пароль (якщо є) — у самому URL: redis://:<пароль>@127.0.0.1:6379/1
# DJANGO_REDIS_URL=redis://127.0.0.1:6379/1
# Свідомий виняток для одного процесу без Redis (тестовий тунель, sandbox) — не для production:
# DJANGO_ALLOW_LOCAL_CACHE=True

# --- PostgreSQL (production; без цих рядків — SQLite). Потрібно: pip install "psycopg[binary]" ---
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=mobihome
# DJANGO_DB_USER=mobihome
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=127.0.0.1
# DJANGO_DB_PORT=5432

# --- Шляхи (необов'язково) ---
# DJANGO_SQLITE_PATH=/var/lib/mobihome/db.sqlite3
# DJANGO_MEDIA_ROOT=/var/lib/mobihome/media
# DJANGO_STATIC_ROOT=/var/www/mobihome/static

# --- Пошта (відновлення пароля). У DEBUG листи виводяться в консоль. ---
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=mobi home <noreply@example.com>

# --- Google OAuth 2.0 (порожньо = вхід через Google вимкнено) ---
# https://console.cloud.google.com/apis/credentials -> OAuth client ID -> Web application
# Authorized redirect URI: https://<ваш-домен>/auth/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Telegram Login Widget (порожньо = вхід через Telegram вимкнено) ---
# Створити бота в @BotFather, потім /setdomain -> ваш домен
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=

# --- Обмеження спроб входу ---
LOGIN_THROTTLE_MAX_ATTEMPTS=5
LOGIN_THROTTLE_WINDOW_SECONDS=900

# --- Оплата розміщення: LiqPay ---
# Ключі: кабінет LiqPay -> налаштування магазину -> API. Тестові починаються з "sandbox_".
# Приватний ключ — лише тут (файл .env не комітиться). Не надсилати в чати/листи.
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# True — тестовий режим (sandbox-ключі, реальні кошти не списуються). False — бойовий.
LIQPAY_SANDBOX=True
# Поточна специфікація LiqPay: 7 + sha3_256. Змінювати лише якщо sandbox-тест покаже інше.
LIQPAY_API_VERSION=7
LIQPAY_SIGNATURE_ALGORITHM=sha3_256
# Хвилин на завершення оплати (після цього незавершений платіж -> «не завершено»).
LIQPAY_PAYMENT_TTL_MINUTES=60
# Публічна HTTPS-адреса сайту без "/" в кінці: з неї будуються server_url і result_url.
SITE_URL=

# Перемикач 1: користувачі МОЖУТЬ платити (checkout). Працює лише з коректною конфігурацією LiqPay.
PAYMENTS_ENABLED=False
# Перемикач 2: каталог ПОКАЗУЄ лише оплачені оголошення (placement_until > now).
# Вмикати лише після PAYMENTS_ENABLED=True, перевірки в sandbox і `apply_placement_transition --apply`.
PLACEMENT_PAYMENT_REQUIRED=False

# --- Контакти сайту (підвал, підтримка, «Контакти»). Не задано — контакти замовника за замовчуванням. ---
# SITE_PHONE=+380991053309
# SITE_OFFICE_PHONE=+380991053309
# SITE_EMAIL=dominikyarem@gmail.com
# SITE_SUPPORT_EMAIL=dominikyarem@gmail.com
# SITE_ADDRESS=Львів, Україна
# Telegram підтримки (не бот модерації): username без @ або https://t.me/<username>
# SITE_TELEGRAM_SUPPORT=Yaremchuk06

# --- Telegram-бот модерації (TELEGRAM_SETUP.md). Використовує TELEGRAM_BOT_TOKEN вище. ---
TELEGRAM_BOT_ENABLED=False
TELEGRAM_MODERATION_CHAT_ID=

# --- Файли ---
# Приватні звіти перевірок житла (поза media, вебсервер їх не роздає):
# DJANGO_PRIVATE_MEDIA_ROOT=/srv/mobihome/data/private
# Роздача /media/ самим Django (локально з DEBUG=False). У production /media/ віддає nginx.
# DJANGO_SERVE_MEDIA=True

# Рівень логування Django (stdout -> journald): DEBUG, INFO, WARNING
# DJANGO_LOG_LEVEL=INFO
